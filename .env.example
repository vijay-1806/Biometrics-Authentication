# Optional: docker compose up works without copying this file.
APP_PORT=8080
ML_PORT=8000
# Allow devices on your LAN to connect. Use 127.0.0.1 for local-only access.
HOST_BIND=0.0.0.0
# Leave blank to generate and persist a unique JWT key in the backend-runtime volume.
# To supply your own key, use at least 32 random characters.
JWT_SECRET=
